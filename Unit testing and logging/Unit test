package com.example.service;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

class UserServiceTest {

    private UserRepository repository;
    private UserService service;

    @BeforeEach
    void setup() {
        repository = mock(UserRepository.class);
        service = new UserService(repository);
    }

    @Test
    void testGetUser_success() {
        when(repository.findUserById(1)).thenReturn("John");

        String result = service.getUser(1);

        assertEquals("John", result);
        verify(repository, times(1)).findUserById(1);
    }

    @Test
    void testGetUser_notFound() {
        when(repository.findUserById(2)).thenReturn(null);

        String result = service.getUser(2);

        assertEquals("User Not Found", result);
    }

    @Test
    void testGetUser_invalidId() {
        Exception exception = assertThrows(IllegalArgumentException.class, () -> {
            service.getUser(-1);
        });

        assertEquals("Invalid ID", exception.getMessage());
    }
}
